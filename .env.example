WOOCOMMERCE_URL=https://your-wordpress-site.example
WORDPRESS_URL=https://your-wordpress-site.example
WOOCOMMERCE_CONSUMER_KEY=ck_replace_with_your_key
WOOCOMMERCE_CONSUMER_SECRET=cs_replace_with_your_secret
ENGINEERPARTS_PROXY_SECRET=replace_with_at_least_32_random_characters
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Single public number for contact phone and WhatsApp, including country code.
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_CONTACT_EMAIL=
# Logging. Development prints to the console; production also stores entries in the
# WordPress engineerparts_logs table (WooCommerce > EngineerParts Logs).
# LOG_LEVEL: debug | info | warn | error (default: info in production).
LOG_LEVEL=info
# Set to false to keep production logs in the host console only.
LOG_TO_DATABASE=true
